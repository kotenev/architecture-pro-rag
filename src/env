# === Конфигурация локального RAG-бота ===

# Каталоги базы и индекса
KB_DIR=knowledge_base
INDEX_DIR=index

# Модель для эмбеддингов (Sentence Transformers)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v3

# Локальная LLM (через HuggingFace Transformers)
LOCAL_LLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
# Альтернатива для GPU:
# LOCAL_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Количество ближайших фрагментов при поиске
TOP_K=5

# Few-shot примеры
FEWSHOT_FILE=examples/fewshot.jsonl

# Безопасные фильтры
SAFETY_BLOCKLIST=superpassword,swordfish,ignore all instructions,root-password
